<?xml version="1.0" encoding="utf-8"?>
<!-- Widget.AirCast.TextButton: accent focus state for the remote (no pointer on a TV). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</selector>

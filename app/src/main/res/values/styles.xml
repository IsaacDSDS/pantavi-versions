<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.AirCast.Display" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AirCast.Headline" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AirCast.Title" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AirCast.Body" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.AirCast.Caption" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.AirCast.Label" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.AirCast.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_xl</item>
    </style>

    <style name="Widget.AirCast.StatusPill" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textAppearance">@style/TextAppearance.AirCast.Label</item>
        <item name="android:drawableStart">@drawable/dot_status</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <style name="Widget.AirCast.StepBadge" parent="">
        <item name="android:layout_width">@dimen/step_badge</item>
        <item name="android:layout_height">@dimen/step_badge</item>
        <item name="android:background">@drawable/bg_step_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.AirCast.Label</item>
    </style>

    <style name="Widget.AirCast.Progress" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:minHeight">@dimen/progress_height</item>
        <item name="android:maxHeight">@dimen/progress_height</item>
        <item name="android:progressTint">@color/accent</item>
        <item name="android:progressBackgroundTint">@color/surface_elevated</item>
    </style>

    <!-- A TextView, not a Button: no platform caps, minimum sizes or ripple. -->
    <style name="Widget.AirCast.TextButton" parent="">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textAppearance">@style/TextAppearance.AirCast.Label</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <style name="Widget.AirCast.PlaybackBar" parent="">
        <item name="android:background">@drawable/bg_banner</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
    </style>

    <style name="Widget.AirCast.Banner" parent="">
        <item name="android:background">@drawable/bg_banner</item>
        <item name="android:textAppearance">@style/TextAppearance.AirCast.Label</item>
        <item name="android:paddingStart">@dimen/space_l</item>
        <item name="android:paddingEnd">@dimen/space_l</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
    </style>
</resources>
